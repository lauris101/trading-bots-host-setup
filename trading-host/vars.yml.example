# Copy to vars.yml (gitignored) and fill in. Loaded by site.yml.

# The account the trading stack runs under. Its SSH key: by default the same
# key terraform gave the admin user (ssh_public_key in terraform.tfvars,
# carried into the inventory). To use a different one, put a public key
# line or a path to a .pub file here instead.
trading_bot_user: trading-bot
trading_bot_public_key: "{{ ssh_public_key }}"
# Passwordless sudo for that account. Needed for deploy.sh's apt installs
# and for the log/data directories; one operator, one box, so on by default.
trading_bot_sudo: true

# Who else may SSH in. Not normally set: the role already allows the
# trading account and the account ansible is connected as (the image's own
# login, from terraform's ssh_admin_user), so the distribution is named in
# one place only. Set this to admit an extra human, and keep the trading
# account in the list -- an override replaces the default, it does not add
# to it.
# sshd_allow_users:
#   - "{{ trading_bot_user }}"
#   - someone-else

# CrowdSec (port 22 is open to the internet). Addresses never to ban: the
# dev box, any fixed address you trust. The laptop has none, so it relies on
# keys-only sshd not tripping the scenarios (a wrong key is not a ban; a
# burst of failed logins is).
crowdsec_whitelist_cidrs:
  - "78.47.39.128/32"
  - "167.233.189.172/32"
# Optional: an enrollment key from app.crowdsec.net to see alerts in the
# console. Empty = not enrolled (the community blocklist works regardless).
crowdsec_enroll_key: ""
# CrowdSec's local API (loopback only) defaults to 8080, which control uses
# on the trading host; it listens here instead. Same value on both hosts.
crowdsec_lapi_port: 8770
# The suite in CrowdSec's repository: the Debian release name. If it still
# has no trixie suite, bookworm's packages are static Go binaries and run
# on trixie unchanged -- check before a rebuild.
crowdsec_repo_suite: bookworm

# Cores the kernel keeps off (isolcpus, nohz_full, rcu_nocbs), one per
# spinning bot thread (pinned with hot_path.*_cpus in the bot config).
# c7g.2xlarge has 8 cores, no SMT. Changing this line reboots the box.
#
# Five isolated, one per spinner: two parse (3,4), two strategy (5,6),
# one send (7). Two parse workers rather than the original one because
# market data now carries every venue in both roles on the same workers,
# and a parse worker's poll lap -- and so the kernel-buffer wait every
# quote pays -- grows with the sockets it holds, about 1.2 us each
# (measured 2026-09-29: six sockets, 7.1 us lap, 8 us p50 wait).
#
# In the trading-bots .env: BOT_CPUSET=0-7, BOT_HOUSEKEEPING_CPUS=0-2,
# BOT_PARSE_CPUS=3,4 BOT_STRATEGY_CPUS=5,6 BOT_SEND_CPUS=7. The cpuset has
# to include 0-2 or the housekeeping pin cannot be applied.
hotpath_isolated_cpus: "3-7"
# The other cores: the kernel, the bot's tokio and logger threads, the
# kernel's default interrupt affinity and every network queue interrupt
# (irqaffinity=, bot-irq-affinity.service).
hotpath_housekeeping_cpus: "0-2"

# Prefixes for the stack's data and log roots, exactly as DATA_BASE_DIR and
# LOGS_BASE_DIR in the trading-bots .env: the stack mounts
# ${DATA_BASE_DIR}/data/trading-bots and ${LOGS_BASE_DIR}/logs/trading-bots,
# so empty means /data/trading-bots and /logs/trading-bots on the root volume.
data_base_dir: ""
logs_base_dir: ""

# Hostname to set on the box.
host_name: trading-host
