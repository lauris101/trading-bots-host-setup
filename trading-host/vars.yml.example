# Copy to vars.yml (gitignored) and fill in. Loaded by site.yml.

# The account the trading stack runs under. Its SSH key: by default the same
# key terraform gave the admin user (ssh_public_key in terraform.tfvars,
# carried into the inventory). To use a different one, put a public key
# line or a path to a .pub file here instead.
trading_bot_user: trading-bot
trading_bot_public_key: "{{ ssh_public_key }}"
# Passwordless sudo for that account. Needed for deploy.sh's apt installs
# and for the log/data directories; one operator, one box, so on by default.
trading_bot_sudo: true

# Who else may SSH in. The AMI's admin user stays (Ansible logs in as it).
sshd_allow_users:
  - admin
  - "{{ trading_bot_user }}"

# CrowdSec (port 22 is open to the internet). Addresses never to ban: the
# dev box, any fixed address you trust. The laptop has none, so it relies on
# keys-only sshd not tripping the scenarios (a wrong key is not a ban; a
# burst of failed logins is).
crowdsec_whitelist_cidrs:
  - "78.47.39.128/32"
  - "167.233.189.172/32"
# Optional: an enrollment key from app.crowdsec.net to see alerts in the
# console. Empty = not enrolled (the community blocklist works regardless).
crowdsec_enroll_key: ""
# CrowdSec's local API (loopback only) defaults to 8080, which control uses
# on the trading host; it listens here instead. Same value on both hosts.
crowdsec_lapi_port: 8770
# CrowdSec's repo has no trixie suite yet; its bookworm packages are static
# binaries and run on trixie. Change when trixie appears.
crowdsec_repo_suite: bookworm

# Cores the kernel keeps off (isolcpus, nohz_full, rcu_nocbs), one per
# spinning thread. Without hyperstream: "4-7" for the bot's four pinned
# workers (hot_path.*_cpus), BOT_CPUSET=2-7, housekeeping "0-3". With
# hyperstream (below): the producer's two shards take 2-3 as well, so the
# isolated set is "2-7", housekeeping "0-1", BOT_CPUSET=0-1,4-7 and
# HYPERSTREAM_CPUSET=2-3 in the trading-bots .env. c7g.2xlarge has 8
# cores, no SMT. Changing this line reboots the box.
hotpath_isolated_cpus: "2-7"
# The other cores: the kernel's default interrupt affinity and every network
# queue interrupt go here (irqaffinity=, bot-irq-affinity.service).
hotpath_housekeeping_cpus: "0-1"

# EXPERIMENTAL: the hyperstream producer's host side (trading-bots branch
# hyperstream; terraform hyperstream_eni = true for the second ENI).
hyperstream_enabled: true
# The producer's cores: inside hotpath_isolated_cpus, disjoint from the
# bot's pins.
hyperstream_cpus: "2-3"
# Hand the second ENI to vfio-pci for DPDK. Start with false: the producer
# runs on the kernel stack first (the socket race is measured there); flip
# to true and `just tags hyperstream` for the DPDK run.
#
# With true the kernel loses the interface, so the producer must run under
# the trading-bots compose profile `hyperstream-dpdk` rather than
# `hyperstream` -- the kernel-stack one would have no interface to use.
# The bind unit writes /etc/hyperstream/nic.env with the addresses, the
# resolved seed peers and control's address; that profile reads it.
# Control must also be bound to the host's primary private address
# (API_BIND in the trading-bots .env): the native stack has no loopback.
hyperstream_dpdk: false
# 2 MB hugepages for DPDK (512 = 1 GiB).
hyperstream_hugepages_2m: 512

# Prefixes for the stack's data and log roots, exactly as DATA_BASE_DIR and
# LOGS_BASE_DIR in the trading-bots .env: the stack mounts
# ${DATA_BASE_DIR}/data/trading-bots and ${LOGS_BASE_DIR}/logs/trading-bots,
# so empty means /data/trading-bots and /logs/trading-bots on the root volume.
data_base_dir: ""
logs_base_dir: ""

# Hostname to set on the box.
host_name: trading-host
