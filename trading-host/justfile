# trading-host task runner (run from this directory). `just --list` for an overview.
# Two layers: terraform makes the AWS resources, ansible makes the OS.
# Shared roles live in ../ansible/roles.

tf := "terraform -chdir=terraform"
ansible := "ansible-playbook -i inventory/hosts.yml"

# Install the tools: Homebrew on a Mac, apt + pipx on Debian/Ubuntu (README "Tools")
tools:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "$(uname)" = Darwin ]; then
        command -v brew >/dev/null || { echo "install Homebrew first: https://brew.sh"; exit 1; }
        brew list hashicorp/tap/terraform >/dev/null 2>&1 || brew install hashicorp/tap/terraform
        brew list ansible >/dev/null 2>&1 || brew install ansible
        brew list awscli >/dev/null 2>&1 || brew install awscli
    else
        command -v terraform >/dev/null || echo "terraform: https://developer.hashicorp.com/terraform/install (or apt install opentofu and set tf := \"tofu -chdir=terraform\" here)"
        command -v ansible-playbook >/dev/null || { command -v pipx >/dev/null || sudo apt-get install -y pipx; pipx install --include-deps ansible-core; }
    fi
    ansible-galaxy collection install -r ../ansible/requirements.yml
    terraform version | head -1; ansible --version | head -1

# --- AWS resources (terraform) ------------------------------------------------

# Download the providers and connect to the state bucket (backend.hcl at the repo root)
init:
    {{tf}} init -backend-config="$(pwd)/../backend.hcl"

# Move an existing LOCAL state into the bucket (one-time, if apply ran before the backend existed)
init-migrate:
    {{tf}} init -backend-config="$(pwd)/../backend.hcl" -migrate-state

# Save a copy of the current state to ~/tfstate-backups (R2 keeps no versions); runs before every apply/destroy
state-backup:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p ~/tfstate-backups
    f=~/tfstate-backups/$(basename "$(pwd)")-$(date -u +%Y%m%dT%H%M%SZ).tfstate
    {{tf}} state pull > "$f"
    if [ ! -s "$f" ] || [ "$(jq -r '.resources | length' "$f" 2>/dev/null || echo 0)" = "0" ]; then
        rm -f "$f"; echo "state-backup: no state yet, nothing to copy"; exit 0
    fi
    ls -t ~/tfstate-backups/$(basename "$(pwd)")-*.tfstate | tail -n +31 | xargs -r rm --   # keep the last 30
    echo "state-backup: $f ($(jq '.resources | length' "$f") resources)"

# Show what would change
plan:
    {{tf}} fmt -recursive
    {{tf}} validate
    {{tf}} plan

# Create or update the AWS resources (state backed up first), then refresh the ansible inventory
apply:
    just state-backup
    {{tf}} apply
    just inventory

# Replace the instance (a new availability_zone, a new AMI): lift termination protection first, then apply
rebuild:
    just state-backup
    {{tf}} apply -target=aws_instance.host -var termination_protection=false
    {{tf}} apply
    just inventory

# Write inventory/hosts.yml from the terraform outputs
inventory:
    mkdir -p inventory
    {{tf}} output -raw ansible_inventory > inventory/hosts.yml
    @echo "wrote inventory/hosts.yml:"; cat inventory/hosts.yml

# The elastic IPs and what each is bound to
ips:
    {{tf}} output addresses

# --- the OS (ansible) ---------------------------------------------------------

# Check ansible can reach the host as admin
ping:
    ansible -i inventory/hosts.yml all -m ping

# Dry run of the playbook: what would change on the host
check:
    {{ansible}} playbook.yml --check --diff

# Configure the host (idempotent; reboots only if the kernel command line changed)
provision:
    {{ansible}} playbook.yml --diff

# Run a subset, e.g. `just tags trading_bot_user,sshd`
tags tags:
    {{ansible}} playbook.yml --diff --tags {{tags}}

# SSH in as admin (ansible's user), with the key from the inventory
ssh:
    ssh -i $({{tf}} output -raw ssh_private_key_file) admin@$({{tf}} output -raw ssh | sed 's/^ssh admin@//')

# SSH in as the trading-bot account
ssh-bot:
    ssh -i $({{tf}} output -raw ssh_private_key_file) trading-bot@$({{tf}} output -raw ssh | sed 's/^ssh admin@//')

# TCP connect latency from the host to every Hyperliquid API address (compare AZs with this)
latency samples="20":
    ssh -i $({{tf}} output -raw ssh_private_key_file) admin@$({{tf}} output -raw ssh | sed 's/^ssh admin@//') 'LC_ALL=C bash -s' -- {{samples}} < scripts/hl-latency.sh

# --- teardown -----------------------------------------------------------------

# Park: destroy the INSTANCE only (its disk goes with it); the elastic IPs stay allocated, so bypass lists and DNS keep working. README "Park"
park:
    just state-backup
    {{tf}} apply -target=aws_instance.host -var termination_protection=false
    {{tf}} destroy -target=aws_instance.host

# Unpark: recreate the instance on the same elastic IPs; a fresh disk, so `just provision` again (and a new github deploy key)
unpark:
    just state-backup
    {{tf}} apply
    just inventory
    @echo "next: ssh-keygen -R <ip> for the new host key, then just provision"

# Destroy everything: lift termination protection on the instance (confirm), then destroy (confirm). README "Tear down"
destroy:
    just state-backup
    {{tf}} apply -target=aws_instance.host -var termination_protection=false
    {{tf}} destroy

# The host's GitHub deploy key (public half), to paste into the repository's Deploy keys
deploy-key:
    ansible -i inventory.yml all -m ansible.builtin.command -a "cat /home/trading-bot/.ssh/id_ed25519_github.pub" | grep -v -E '^\S+ \| (SUCCESS|CHANGED)'
