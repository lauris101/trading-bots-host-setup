# Copy to terraform.tfvars (gitignored) and fill in.

# Who may SSH in: the only inbound rule. Default (variables.tf) is the whole
# internet, because the laptop has no fixed address; sshd is key-only and
# CrowdSec bans brute-forcers. With a fixed address, list /32s instead:
# ssh_allowed_cidrs = ["78.47.39.128/32", "167.233.189.172/32"]

# The one SSH key: the image's `admin` user (Ansible's login) and, through
# Ansible, the trading-bot account.
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"
# Its private half on this laptop (goes into the ansible inventory).
ssh_private_key_file = "~/.ssh/id_ed25519_trading"

# The IAM user made for this repo (README "Credentials"), a profile in
# ~/.aws/credentials.
aws_profile = "trading"

# Defaults, shown so they are easy to change:
# region                 = "ap-northeast-1"
# The zone, as a zone ID: the names are per-account aliases, so apne1-az4 is
# this account's `ap-northeast-1a`. The default is apne1-az2, where the host
# runs today. apne1-az4 measured ~550 us closer to the leader venue (README
# "Availability zone"); setting it here replaces subnet, ENI and instance, so
# it belongs in a rebuild and nowhere else.
# availability_zone_id   = "apne1-az4"
# name                   = "trading-host"
# The image's own login account, which Ansible connects as. Debian is
# `admin`. Set this to what the RUNNING host has while it differs from the
# image this config names -- a distribution change does not move a live
# instance, because the AMI is pinned. Delete the line after the rebuild.
# ssh_admin_user = "ubuntu"

# instance_type          = "c7g.2xlarge"
# root_volume_gb         = 80
# elastic_ip_count       = 3
# termination_protection = true
