# Copy to terraform.tfvars (gitignored) and fill in.

# Who may SSH in: the only inbound rule. Default (variables.tf) is the whole
# internet, because the laptop has no fixed address; sshd is key-only and
# CrowdSec bans brute-forcers. With a fixed address, list /32s instead:
# ssh_allowed_cidrs = ["78.47.39.128/32", "167.233.189.172/32"]

# The one SSH key: the AMI's `admin` user (Ansible's login) and, through
# Ansible, the trading-bot account.
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# The IAM user made for this repo (README "Credentials"), a profile in
# ~/.aws/credentials.
aws_profile = "trading"

# Defaults, shown so they are easy to change:
# region                 = "ap-northeast-1"
# availability_zone      = "ap-northeast-1a"
# name                   = "trading-host"
# instance_type          = "c7g.2xlarge"
# root_volume_gb         = 80
# elastic_ip_count       = 3
# termination_protection = true
