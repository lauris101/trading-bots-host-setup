# terraform: state, plans, provider cache, real variable values
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/terraform.tfvars
terraform/*.auto.tfvars
terraform/crash.log

# ansible: generated inventory, real variable values, retry files
ansible/inventory/hosts.yml
ansible/vars.yml
ansible/*.retry
ansible/.ansible/

# keys never live here
*.pem
*.key
id_*
!id_*.pub.example
