#!/bin/sh
# Hand the hyperstream ENI (device index 1) to vfio-pci for DPDK, and write
# what the producer needs to know about it to /etc/hyperstream/nic.env.
# Managed by ansible (trading-bots-host-setup, role hyperstream_host).
#
# Idempotent: a device already on vfio-pci is left alone. The primary ENI
# (device index 0) is never touched. Reads the instance metadata (IMDSv2)
# for the ENI's address, mask and gateway, since the kernel will no longer
# hold them once the device is unbound.
set -eu

IMDS="http://169.254.169.254/latest"
TOKEN="$(curl -sf -X PUT "$IMDS/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60")" || {
  echo "hyperstream-nic-bind: no IMDS token (not on EC2?)" >&2; exit 1
}
md() { curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" "$IMDS/meta-data/$1"; }

MAC=""
for m in $(md network/interfaces/macs/ | tr -d '/'); do
  if [ "$(md "network/interfaces/macs/$m/device-number")" = "1" ]; then MAC="$m"; fi
done
[ -n "$MAC" ] || { echo "hyperstream-nic-bind: no ENI at device index 1" >&2; exit 1; }
echo "hyperstream-nic-bind: device 1 is $MAC" 

IP="$(md "network/interfaces/macs/$MAC/local-ipv4s" | head -1)"
CIDR="$(md "network/interfaces/macs/$MAC/subnet-ipv4-cidr-block")"
PREFIX="${CIDR#*/}"
# The VPC gateway is the subnet's first address.
NET="${CIDR%/*}"
GW="$(echo "$NET" | awk -F. '{printf "%d.%d.%d.%d", $1, $2, $3, $4 + 1}')"

# Which PCI device carries this MAC: through the netdev while the kernel
# still has it, or from the record of a previous bind.
mkdir -p /etc/hyperstream
PCI=""
IFACE="$(ip -o link | awk -v mac="$MAC" 'tolower($0) ~ mac {sub(":", "", $2); print $2; exit}')"
if [ -n "$IFACE" ]; then
  PCI="$(basename "$(readlink -f "/sys/class/net/$IFACE/device")")"
elif [ -f /etc/hyperstream/nic.env ]; then
  PCI="$(sed -n 's/^HYPERSTREAM_PCI=//p' /etc/hyperstream/nic.env)"
fi
[ -n "$PCI" ] || { echo "hyperstream-nic-bind: cannot find the PCI device for $MAC" >&2; exit 1; }
echo "hyperstream-nic-bind: $MAC is $PCI (netdev '${IFACE:-gone}')" 

# Two things the producer cannot work out for itself once it is on the
# native stack, recorded here while the kernel still has a network.
#
# Control: no loopback route on Seastar's stack, so 127.0.0.1 is not
# reachable. It goes across the VPC to the PRIMARY ENI's private address
# (device index 0) instead, which the security group allows from this ENI
# and which control must be listening on (API_BIND).
PRIMARY_MAC="$(for m in $(md network/interfaces/macs/ | tr -d '/'); do
  if [ "$(md "network/interfaces/macs/$m/device-number")" = "0" ]; then echo "$m"; fi
done)"
CONTROL_IP="$(md "network/interfaces/macs/$PRIMARY_MAC/local-ipv4s" | head -1)"

# Peers: no resolver route either, so the pool needs seeding. Discovery
# continues afterwards through control's /resolve.
PEERS="$(getent ahostsv4 "${HYPERSTREAM_STREAM_HOST:-fstream.binance.com}" \
  | awk '{print $1}' | sort -u | paste -sd, - || true)"

cat > /etc/hyperstream/nic.env <<EOF
# Written by hyperstream-nic-bind; read by the producer's compose service.
HYPERSTREAM_PCI=$PCI
HYPERSTREAM_MAC=$MAC
HYPERSTREAM_IPV4=$IP
HYPERSTREAM_PREFIX=$PREFIX
HYPERSTREAM_NETMASK=$(awk -v p="$PREFIX" 'BEGIN{m=0; for(i=0;i<p;i++) m=m*2+1; m=m*2^(32-p); printf "%d.%d.%d.%d", int(m/16777216)%256, int(m/65536)%256, int(m/256)%256, m%256}')
HYPERSTREAM_GATEWAY=$GW
HYPERSTREAM_CONTROL_IP=$CONTROL_IP
HYPERSTREAM_PEER_IPS=$PEERS
EOF

# Which driver has it now. `readlink -f` SUCCEEDS on a path whose last
# component does not exist -- it just prints it -- so a driverless device
# would come out as "driver" and the unbind below would go to
# /sys/bus/pci/drivers/driver/unbind. Test the symlink instead. A device
# can genuinely be driverless: a previous run that unbound and then failed
# to bind leaves it exactly there.
if [ -L "/sys/bus/pci/devices/$PCI/driver" ]; then
  current="$(basename "$(readlink -f "/sys/bus/pci/devices/$PCI/driver")")"
else
  current=none
fi
if [ "$current" = "vfio-pci" ]; then
  echo "hyperstream-nic-bind: $PCI ($MAC, $IP/$PREFIX) already on vfio-pci"; exit 0
fi
echo "hyperstream-nic-bind: $PCI ($MAC, $IP/$PREFIX, gw $GW) is on '$current'; moving it to vfio-pci"

modprobe vfio-pci || {
  echo "hyperstream-nic-bind: modprobe vfio-pci failed; is the module built for $(uname -r)?" >&2
  exit 1
}

# Nitro gives the guest no IOMMU, so vfio-pci can only take the device in
# no-IOMMU mode. Without it the bind fails with EIO -- the driver's probe
# refusing the device -- which says nothing about why. The module
# parameter is ignored when vfio is already loaded, so setting it at
# runtime is the reliable path; the modprobe.d drop-in covers the boot.
NOIOMMU=/sys/module/vfio/parameters/enable_unsafe_noiommu_mode
if [ ! -d "/sys/bus/pci/devices/$PCI/iommu_group" ]; then
  if [ ! -f "$NOIOMMU" ]; then
    echo "hyperstream-nic-bind: $PCI has no IOMMU group and this kernel has no" >&2
    echo "  VFIO no-IOMMU support ($NOIOMMU is absent, CONFIG_VFIO_NOIOMMU=n)." >&2
    echo "  vfio-pci cannot drive this device on $(uname -r)." >&2
    exit 1
  fi
  case "$(cat "$NOIOMMU")" in
    Y|y|1) ;;
    *) echo 1 > "$NOIOMMU" 2>/dev/null || true ;;
  esac
  case "$(cat "$NOIOMMU")" in
    Y|y|1) echo "hyperstream-nic-bind: vfio no-IOMMU mode is on (no guest IOMMU here)" ;;
    *) echo "hyperstream-nic-bind: cannot enable vfio no-IOMMU mode ($NOIOMMU is $(cat "$NOIOMMU")); the bind would fail with EIO" >&2
       exit 1 ;;
  esac
fi
if [ -n "$IFACE" ]; then ip link set dev "$IFACE" down || true; fi
echo vfio-pci > "/sys/bus/pci/devices/$PCI/driver_override"
if [ "$current" != "none" ]; then
  echo "$PCI" > "/sys/bus/pci/drivers/$current/unbind"
fi
# Already bound is success, not failure: with driver_override set, some
# kernels re-probe the device onto vfio-pci as soon as it is released, and
# the explicit bind then fails with EBUSY or ENODEV.
if [ ! -L "/sys/bus/pci/devices/$PCI/driver" ]; then
  echo "$PCI" > /sys/bus/pci/drivers/vfio-pci/bind || true
fi
now="$(basename "$(readlink -f "/sys/bus/pci/devices/$PCI/driver" 2>/dev/null)")"
[ "$now" = "vfio-pci" ] || {
  echo "hyperstream-nic-bind: $PCI is on '$now' after the bind, not vfio-pci" >&2
  exit 1
}
echo "hyperstream-nic-bind: $PCI ($MAC, $IP/$PREFIX, gw $GW) bound to vfio-pci (was $current)"
