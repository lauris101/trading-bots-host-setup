# Copy to vars.yml (gitignored) and fill in. Loaded by site.yml.

# The account the trading stack runs under. Its SSH key: by default the same
# key terraform gave the admin user (ssh_public_key in terraform.tfvars,
# carried into the inventory). To use a different one, put a public key
# line or a path to a .pub file here instead.
trading_bot_user: trading-bot
trading_bot_public_key: "{{ ssh_public_key }}"
# Passwordless sudo for that account. Needed for deploy.sh's apt installs
# and for the log/data directories; one operator, one box, so on by default.
trading_bot_sudo: true

# Who else may SSH in. The AMI's admin user stays (Ansible logs in as it).
sshd_allow_users:
  - admin
  - "{{ trading_bot_user }}"

# Cores the kernel keeps off (isolcpus, nohz_full, rcu_nocbs), for the bot's
# spinning threads. Must match BOT_CPUSET in trading-bots/.env. c7g.2xlarge
# has 8 cores with no SMT: 0-1 for the OS and the other services, 2-5 for
# the bot, 6-7 spare.
hotpath_isolated_cpus: "2-5"

# Where the stack keeps data and logs (DATA_BASE_DIR / LOGS_BASE_DIR in the
# trading-bots .env). On the 80 GB root volume.
data_base_dir: /data
logs_base_dir: /logs

# Hostname to set on the box.
host_name: trading-host
