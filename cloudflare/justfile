# cloudflare task runner (run from this directory). `just --list` for an overview.
# Terraform against the Cloudflare API: tunnels, DNS, Access.
# The API token comes from terraform.tfvars (cloudflare_api_token) or, unset
# there, from CLOUDFLARE_API_TOKEN in the environment (README "API token").

tf := "terraform -chdir=."

# Download the providers and connect to the state bucket (backend.hcl at the repo root)
init:
    {{tf}} init -backend-config="$(pwd)/../backend.hcl"

# Move an existing LOCAL state into the bucket (one-time, if apply ran before the backend existed)
init-migrate:
    {{tf}} init -backend-config="$(pwd)/../backend.hcl" -migrate-state

# Save a copy of the current state to ~/tfstate-backups (R2 keeps no versions); runs before every apply/destroy
state-backup:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p ~/tfstate-backups
    f=~/tfstate-backups/$(basename "$(pwd)")-$(date -u +%Y%m%dT%H%M%SZ).tfstate
    {{tf}} state pull > "$f"
    if [ ! -s "$f" ] || [ "$(jq -r '.resources | length' "$f" 2>/dev/null || echo 0)" = "0" ]; then
        rm -f "$f"; echo "state-backup: no state yet, nothing to copy"; exit 0
    fi
    ls -t ~/tfstate-backups/$(basename "$(pwd)")-*.tfstate | tail -n +31 | xargs -r rm --   # keep the last 30
    echo "state-backup: $f ($(jq '.resources | length' "$f") resources)"

# fmt, validate, plan
plan:
    {{tf}} fmt -recursive
    {{tf}} validate
    {{tf}} plan

# Create or update tunnels, hostnames and Access apps (state backed up first)
apply:
    just state-backup
    {{tf}} apply

# Every hostname, its tunnel and origin
hostnames:
    {{tf}} output hostnames

# The trading host's tunnel token (CLOUDFLARE_TUNNEL_TOKEN in trading-bots/.env)
app-token:
    @{{tf}} output -raw app_tunnel_token

# The database host's tunnel token (CLOUDFLARE_TUNNEL_TOKEN in trading-bots-db/.env)
db-token:
    @{{tf}} output -raw db_tunnel_token

# Log in to a TCP hostname from this laptop and forward it locally, e.g. `just tcp db 15432` then psql -h 127.0.0.1 -p 15432
tcp label port:
    cloudflared access tcp --hostname {{label}}.$({{tf}} output -raw domain 2>/dev/null || echo lz-co.xyz) --url 127.0.0.1:{{port}}

# Forward postgres (15432), clickhouse native (19000) and clickhouse http (18123) from this laptop, all at once; Ctrl-C stops all three
tunnels:
    #!/usr/bin/env bash
    set -euo pipefail
    domain=$({{tf}} output -raw domain 2>/dev/null || echo lz-co.xyz)
    pids=()
    trap 'kill "${pids[@]}" 2>/dev/null; wait; echo; echo "tunnels closed"' INT TERM EXIT
    for pair in db:15432 ch:19000 chdb:18123; do
        label=${pair%%:*}; port=${pair##*:}
        cloudflared access tcp --hostname "$label.$domain" --url "127.0.0.1:$port" &
        pids+=($!)
    done
    echo "postgres          127.0.0.1:15432  -> db.$domain"
    echo "clickhouse native 127.0.0.1:19000  -> ch.$domain"
    echo "clickhouse http   127.0.0.1:18123  -> chdb.$domain"
    echo "Ctrl-C closes all three"
    wait

# Tear down (the hosts' cloudflared then fail to connect; DNS names go away)
destroy:
    just state-backup
    {{tf}} destroy

# Explain a recipe from ../docs/just.md (this directory's section), e.g. `just help apply`; no argument lists them all
help *recipe:
    #!/usr/bin/env bash
    set -euo pipefail
    doc="{{justfile_directory()}}/../docs/just.md"
    section="## \`$(basename "{{justfile_directory()}}")/\`"
    if [ -z "{{recipe}}" ]; then just --list; echo; echo "just help <recipe> explains one; the whole guide: $doc"; exit 0; fi
    row="$(awk -v s="$section" 'index($0, s) == 1 { on = 1; next } /^## / { on = 0 } on' "$doc" | grep -E '^\| `just {{recipe}}( |`)' || true)"
    if [ -z "$row" ]; then echo "no recipe '{{recipe}}' in the $(basename "{{justfile_directory()}}") section of $doc"; exit 1; fi
    echo "$row" | sed -e 's/^| //' -e 's/ |$//' | awk -F' \\| ' '{ printf "%s\n  runs: %s\n  use:  %s\n", $1, $2, $3 }'
