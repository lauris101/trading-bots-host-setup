# Copy to terraform.tfvars (gitignored) and fill in.
# The API token is NOT here: export CLOUDFLARE_API_TOKEN=... (README).

account_id = "0123456789abcdef0123456789abcdef"
zone_id    = "0123456789abcdef0123456789abcdef"
domain     = "lz-co.xyz"

# Who may log in (one-time PIN to these addresses).
allowed_emails = ["you@example.com"]

# Machines that skip the login: the trading host's three elastic IPs
# (`just ips` in ../trading-host) and the dev box. Fill in after the
# trading host exists; an empty list is fine to start.
# A machine that reaches Cloudflare over IPv6 shows up with its IPv6 source,
# so list BOTH families for any host that has IPv6 (the dev box does; its
# shell picks IPv6, its docker containers IPv4). The trading host has no
# IPv6 at all (the VPC has none), so its three EIPs are the whole story.
bypass_cidrs = [
  # "13.x.x.x/32", "13.x.x.y/32", "13.x.x.z/32",          # trading host EIPs
  # "78.47.39.128/32", "167.233.189.172/32",             # dev box, IPv4
  # "2a01:4f8:c2c:d113::/64",                            # dev box, IPv6
]

# Optional: plain names for the hosts themselves, for ssh. Not used by the
# tunnels. Unproxied A records, so they reveal the addresses.
# host_a_records = { "trading-host" = "13.x.x.x", "db-host" = "203.0.113.10" }

# Hostnames and origins have defaults (variables.tf): app./metrics. on the
# trading host, db./ch./chdb./scraper./metrics-db. on the database host.
# Override here to add or drop one, e.g.
# app_ingress = { app = "http://127.0.0.1:8080" }
